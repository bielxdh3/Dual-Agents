{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "files_changed", "commands_run", "tests", "remaining_issues"],
  "properties": {
    "summary": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "commands_run": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "details"],
        "properties": {
          "command": {"type": "string"},
          "status": {"type": "string", "enum": ["passed", "failed", "not_run"]},
          "details": {"type": "string"}
        }
      }
    },
    "remaining_issues": {"type": "array", "items": {"type": "string"}},
    "memory_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject", "content", "evidence"],
        "properties": {
          "kind": {"type": "string", "enum": ["decision", "architecture", "workflow", "constraint", "discovery"]},
          "subject": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "security_scan_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "plugin_version", "target_identity", "scan_id", "mode", "initial_status", "action", "final_status"],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1},
        "target_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "target_id", "revision", "scope"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "target_id": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "scan_id": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["standard", "deep"]},
        "initial_status": {"type": "string", "enum": ["running", "complete", "failed", "canceled"]},
        "action": {"type": "string", "enum": ["reused", "resumed", "started", "awaited", "conflict"]},
        "final_status": {"type": "string", "enum": ["running", "complete", "failed", "canceled"]}
      }
    }
  }
}
